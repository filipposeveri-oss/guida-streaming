# Obbligatoria: API key v3 oppure token di lettura v4 di TMDB (themoviedb.org/settings/api)
TMDB_TOKEN=
# Consigliata: API key OMDb per i voti IMDb e Rotten Tomatoes (omdbapi.com/apikey.aspx)
OMDB_KEY=

# Facoltative
REGION=IT
LANGUAGE=it-IT
# ID TMDB delle piattaforme separati da virgola; vuoto = scelta automatica delle principali
PROVIDERS=
PROVIDER_LIMIT=12
# Pagine da 20 titoli per piattaforma e tipo (film/serie)
PAGES_POPULAR=5
PAGES_RECENT=2
# Richieste OMDb massime al giorno (il piano free ne consente 1.000)
OMDB_DAILY_BUDGET=900
# Dopo quanti giorni aggiornare un voto già scaricato
RATING_TTL_DAYS=30

# Solo per il server
PORT=8080
SYNC_HOUR=4
# always | missing | never
SYNC_ON_START=missing
